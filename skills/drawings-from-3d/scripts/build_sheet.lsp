;; drawings-from-3d : build one sheet in AutoCAD (core console) on a copy of the empty BAAK base.
;; Expects sheet_cfg.lsp (written by make_sheet.py) to define:
;;   bs-data bs-tpl-dwg bs-tpl bs-name bs-title bs-doc bs-niv bs-date bs-vp (x1 y1 x2 y2) bs-cx bs-cy bs-vh bs-pdf bs-dwg
(defun bslog (s) (princ (strcat "\nMZLOG " s)))
(setq bs-n 0)
(defun tc (r g b) (+ (* r 65536) (* g 256) b))
;; ---------------------------------------------------------------- model-space primitives
(defun e-pl (lay lw r g b closed pts / e)
  (setq e (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) (cons 420 (tc r g b)) (cons 370 lw) '(100 . "AcDbPolyline")
                (cons 90 (length pts)) (cons 70 (if (= closed 1) 1 0)) '(43 . 0.0)))
  (foreach p pts (setq e (append e (list (list 10 (car p) (cadr p))))))
  (if (entmake e) (setq bs-n (1+ bs-n))))
(defun e-hatch (lay r g b loops / l)
  (setq l (list '(0 . "HATCH") '(100 . "AcDbEntity") (cons 8 lay) (cons 420 (tc r g b)) '(100 . "AcDbHatch")
                '(10 0.0 0.0 0.0) '(210 0.0 0.0 1.0) '(2 . "SOLID") '(70 . 1) '(71 . 0) (cons 91 (length loops))))
  (foreach lp loops
    (setq l (append l (list '(92 . 2) '(72 . 0) '(73 . 1) (cons 93 (length lp)))))
    (foreach q lp (setq l (append l (list (list 10 (car q) (cadr q))))))
    (setq l (append l (list '(97 . 0)))))
  (setq l (append l (list '(75 . 0) '(76 . 1) '(98 . 1) '(10 0.0 0.0 0.0))))
  (if (entmake l) (setq bs-n (1+ bs-n)) (bslog (strcat "HATCH FAIL " lay))))
(defun e-txt (lay x y h just rot s)
  (entmake (list '(0 . "MTEXT") '(100 . "AcDbEntity") (cons 8 lay) '(62 . 7) '(100 . "AcDbMText")
                 (list 10 x y 0.0) (cons 40 h) '(41 . 0.0) (cons 71 (cond ((= just "C") 2) ((= just "R") 3) (T 1))) '(72 . 5)
                 (cons 1 (strcat "{\\fMalgun Gothic|b0|i0|c0|p34;" s "}")) (cons 50 (* pi (/ rot 180.0)))))
  (setq bs-n (1+ bs-n)))
(defun e-dim (lay sty x1 y1 x2 y2 xd yd rot)
  (setvar "CLAYER" lay)
  (command "_.DIMLINEAR" (list x1 y1 0.0) (list x2 y2 0.0) (if (= rot 0) "_H" "_V") (list xd yd 0.0))
  (setq bs-n (1+ bs-n)))
(defun e-tag (lay x y r h s)
  (entmake (list '(0 . "CIRCLE") (cons 8 lay) '(62 . 7) (cons 370 13) (list 10 x y 0.0) (cons 40 r)))
  (entmake (list '(0 . "MTEXT") '(100 . "AcDbEntity") (cons 8 lay) '(62 . 7) '(100 . "AcDbMText")
                 (list 10 x y 0.0) (cons 40 h) '(41 . 0.0) '(71 . 5) '(72 . 5) (cons 1 (strcat "{\\fMalgun Gothic|b0|i0|c0|p34;" s "}"))))
  (setq bs-n (+ bs-n 2)))
(defun e-dot (lay x y r)
  (entmake (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) '(62 . 7) '(100 . "AcDbPolyline") '(90 . 2) '(70 . 1)
                 (cons 43 r) (list 10 (- x (/ r 2.0)) y) '(42 . 1.0) (list 10 (+ x (/ r 2.0)) y) '(42 . 1.0)))
  (setq bs-n (1+ bs-n)))
;; ---------------------------------------------------------------- cartouche helpers (from the CAH-08 detail sheets)
(defun dt-repl (en pat new / ed)
  (setq ed (entget en))
  (if (wcmatch (cdr (assoc 1 ed)) pat) (progn (entmod (subst (cons 1 new) (assoc 1 ed) ed)) T)))
(defun dt-date (d / b e x n nm)
  (setq n 0 b (tblnext "BLOCK" T))
  (while b
    (setq nm (cdr (assoc 2 b)))
    (if (wcmatch (strcase nm) "*DATEE*,CARTOUCHE*")
      (progn (setq e (cdr (assoc -2 b)))
        (while e (setq x (entget e))
          (if (and (member (cdr (assoc 0 x)) '("TEXT" "MTEXT" "ATTDEF")) (wcmatch (cdr (assoc 1 x)) "*##/##/20##*"))
            (progn (entmod (subst (cons 1 d) (assoc 1 x) x)) (setq n (1+ n))))
          (setq e (entnext e)))))
    (setq b (tblnext "BLOCK")))
  (bslog (strcat "date set in " (itoa n) " text(s)")))
(defun bs-layouts ( / r)
  (foreach pr (dictsearch (namedobjdict) "ACAD_LAYOUT") (if (= (car pr) 3) (setq r (cons (cdr pr) r)))) r)
(defun bs-sheet ( / ss i en ed n vp)
  (command "_.-LAYOUT" "_Copy" bs-tpl bs-name)
  (setvar "CTAB" bs-name)
  (command "_.PSPACE")
  (setq ss (ssget "_X" (list (cons 410 bs-name))) i 0 n 0)
  (while (and ss (< i (sslength ss)))
    (setq en (ssname ss i) ed (entget en))
    (cond ((= (cdr (assoc 8 ed)) "BAAK - TEXTE") (entdel en))
          ((and (= (cdr (assoc 0 ed)) "VIEWPORT") (= (cdr (assoc 8 ed)) "BAAK - CARTOUCHE INVISIBL")) (entdel en))
          ((and (= (cdr (assoc 0 ed)) "MTEXT") (= (cdr (assoc 8 ed)) "BAAK - CARTOUCHE"))
           (if (dt-repl en "*;Signal*tique}" bs-title) (setq n (1+ n)))
           (if (dt-repl en "*;CAH-08-01}" (strcat "\\pxqr;{\\fMalgun Gothic|b0|i0|c0|p34;" bs-doc "}")) (setq n (1+ n)))
           (if (dt-repl en "*;RDC}" (strcat "\\pxqr;{\\fMalgun Gothic|b0|i0|c0|p34;" bs-niv "}")) (setq n (1+ n)))))
    (setq i (1+ i)))
  (setvar "CLAYER" "BAAK - CARTOUCHE INVISIBL")
  (command "_.MVIEW" (list (nth 0 bs-vp) (nth 1 bs-vp) 0.0) (list (nth 2 bs-vp) (nth 3 bs-vp) 0.0))
  (setq vp (entlast))
  (command "_.MSPACE")
  (command "_.ZOOM" "_C" (list bs-cx bs-cy 0.0) bs-vh)
  (command "_.PSPACE")
  (command "_.MVIEW" "_L" "_ON" vp "")
  (setvar "CLAYER" "0")
  (bslog (strcat bs-name " : " (itoa n) " cartouche fields")))

(defun bs-run ()
  (setvar "CMDECHO" 0) (setvar "FILEDIA" 0) (setvar "BACKGROUNDPLOT" 0) (setvar "LAYOUTCREATEVIEWPORT" 0) (setvar "OSMODE" 0)
  (setvar "TILEMODE" 1)
  (command "_.-LAYER" "_T" "*" "_ON" "*" "_U" "*" "")
  (foreach l (list "BAAK - MURS" "BAAK - HACHURES" "BAAK - COTATION" "BAAK - TEXTE" "BAAK - AMENAGEMENT")
    (if (not (tblsearch "LAYER" l)) (bslog (strcat "MISSING LAYER " l))))
  (if (tblsearch "DIMSTYLE" "Detail BAAK") (command "_.-DIMSTYLE" "_R" "Detail BAAK") (bslog "MISSING DIMSTYLE Detail BAAK"))
  (load bs-data)
  (bslog (strcat "entities " (itoa bs-n)))
  (setvar "TILEMODE" 0)
  (command "_.-LAYOUT" "_T" bs-tpl-dwg bs-tpl)
  (if (not (member (strcase bs-tpl) (mapcar 'strcase (bs-layouts)))) (bslog "TEMPLATE NOT IMPORTED") (bslog "template imported"))
  (dt-date bs-date)
  (command "_.-LAYER" "_P" "_N" "BAAK - CARTOUCHE INVISIBL" "")
  (bs-sheet)
  (command "_.-LAYOUT" "_D" bs-tpl)
  (setvar "CTAB" bs-name)
  (command "_.-PLOT" "_Y" "" "DWG To PDF.pc3" "ISO full bleed A1 (841.00 x 594.00 MM)" "_M" "_L" "_N" "_L" "1:1" "0,0" "_Y" "acad.ctb" "_Y" "_N" "_N" "_N"
           bs-pdf "_Y" "_Y")
  (bslog "plotted")
  (command "_.SAVEAS" "2018" bs-dwg)
  (bslog "saved"))
(bs-run)
